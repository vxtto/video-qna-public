POSTGRES_DB=video_qna
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# https://openrouter.ai — used for both the embedding model and the agent
# LLM (see CLAUDE.md core stack decisions). Never commit a real key.
OPENROUTER_API_KEY=
EMBEDDING_MODEL=qwen/qwen3-embedding-8b
LLM_MODEL=deepseek/deepseek-v4-flash

# Host ports for this worktree's stack. Required (docker-compose.yml has
# no fallback default any more, precisely so a bare `docker compose up`
# that skips the line below fails loudly instead of silently rebinding
# onto the wrong port/media mount - see docs/STATUS.md, 2026-09-03). Leave
# unset here and run `scripts/dev-up.sh` instead of `docker compose up`
# directly - it self-assigns free ports into this file on first run and
# reuses them on every later run.
# DB_PORT=5432
# API_PORT=8000

# Point every worktree at one shared copy of the (multi-hundred-MB) movie
# files instead of duplicating them per worktree. Absolute path, no
# trailing slash, e.g. /home/you/coding/video-qna-media. Leave unset to use
# this worktree's own ./data/media.
# MEDIA_HOST_DIR=

# --- everything below is VPS/prod only (docker-compose.yml's "prod"
# profile: caddy + oauth2-proxy) — leave unset for local dev, they're
# never started by a plain `docker compose up`. See DEPLOY.md's "What's
# deployed" and PLAN.md's "Secrets management". ---

# GitHub OAuth App used by oauth2-proxy. Reference copy lives in
# ~/.config/video-qna/secrets.env as GITHUB_OAUTH_CLIENT_ID/_SECRET —
# never commit real values.
# OAUTH2_PROXY_CLIENT_ID=
# OAUTH2_PROXY_CLIENT_SECRET=

# Random 32-byte value, base64-encoded — signs/encrypts oauth2-proxy's
# session cookie. Generate with:
#   python3 -c 'import secrets,base64; print(base64.b64encode(secrets.token_bytes(32)).decode())'
# Rotating it invalidates all logged-in sessions.
# OAUTH2_PROXY_COOKIE_SECRET=
