POSTGRES_DB=video_qna
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# https://openrouter.ai — used for both the embedding model and the agent
# LLM (see CLAUDE.md core stack decisions). Never commit a real key.
OPENROUTER_API_KEY=
EMBEDDING_MODEL=qwen/qwen3-embedding-8b
LLM_MODEL=deepseek/deepseek-v4-flash

# Host ports for this worktree's stack. Only matters when running more than
# one worktree's stack at once on the same box — each worktree needs its
# own pair or they'll fight over 5432/8000. Leave unset and run
# `scripts/dev-up.sh` instead of `docker compose up` directly to have these
# self-assigned to free ports on first run.
# DB_PORT=5432
# API_PORT=8000

# Point every worktree at one shared copy of the (multi-hundred-MB) movie
# files instead of duplicating them per worktree. Absolute path, no
# trailing slash, e.g. /home/you/coding/video-qna-media. Leave unset to use
# this worktree's own ./data/media.
# MEDIA_HOST_DIR=
